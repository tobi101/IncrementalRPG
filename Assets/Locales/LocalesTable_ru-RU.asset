      m_Items: []
  - m_Id: 1000000000021
    m_Localized: "\u0423\u0440\u043E\u043D \u0431\u043E\u043C\u0431"
    m_Metadata:
      m_Items: []
  - m_Id: 1000000000023
    m_Localized: "\u0420\u0430\u0434\u0438\u0443\u0441 \u0432\u0437\u0440\u044B\u0432\u0430"
